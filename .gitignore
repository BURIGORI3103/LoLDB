# Python仮想環境およびキャッシュ
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
ENV/
python_env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# スクラッチ一時作業（ただし正本スクリプト generate_matchup_reasons.py は維持）
scratch/
!scratch/generate_matchup_reasons.py

# 環境変数・APIキー・認証情報（機密情報）
.env
.env.*
!.env.example
!.env.sample
!.env.template
credentials/
secrets/
*.pem
*.key

