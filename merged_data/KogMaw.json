  "abilities": [
    {
      "slot": "Passive",
      "name": "イカシアの自爆",
      "description": "倒されてから4秒後、コグ＝マウは爆発して周囲の敵に確定ダメージを与える。",
      "image": "KogMaw_IcathianSurprise.png"
    }
  ],
  "spells": [
    {
      "slot": "Q",
      "name": "腐食粘液",
      "description": "苛性の粘液を飛ばし、対象に魔法ダメージを与え、物理防御と魔法防御を短時間低下させる。さらにコグ＝マウの攻撃速度が増加する。",
      "cooldown": "7",
      "cost": "40",
      "image": "KogMawQ.png"
    },
    {
      "slot": "W",
      "name": "有機性魔力砲",
      "description": "通常攻撃の射程距離が増加し、対象の最大体力に比例した魔法ダメージ%i:OnHit%<OnHit>通常攻撃時効果</OnHit>を与える。",
      "cooldown": "17",
      "cost": "40",
      "image": "KogMawBioArcaneBarrage.png"
    },
    {
      "slot": "E",
      "name": "ヴォイド分泌液",
      "description": "敵を貫通する謎の粘液を発射し、命中した敵ユニットにダメージを与える。粘液は通過したエリアにしばらく残り、踏んだ敵にスロウ効果を付与する。",
      "cooldown": "12",
      "cost": "40/55/70/85/100",
      "image": "KogMawVoidOoze.png"
    },
    {
      "slot": "R",
      "name": "生体空撃砲",
      "description": "射程の長い砲弾を発射して魔法ダメージ (体力が低い敵には大幅に増加) を与えるとともに、敵を可視状態にする。ただし、ステルス状態の敵の位置を把握することはできない。このスキルを短時間で連発すると、消費マナが増加する。",
      "cooldown": "2/1.5/1",
      "cost": "40",
      "image": "KogMawLivingArtillery.png"
    }
  ],
