      "cost": "60/65/70/75/80",
      "image": "LockeW.png"
    },
    {
      "slot": "E",
      "name": "灰塵の追撃",
      "description": "指定地点にテレポートしてから次の対象へダッシュし、通過した敵にダメージを与える。",
      "cooldown": "10",
      "cost": "30/40/50/60/70",
      "image": "LockeE.png"
    },
    {
      "slot": "R",
      "name": "煉獄",
