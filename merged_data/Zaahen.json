  "abilities": [
    {
      "slot": "Passive",
      "name": "戦威修養",
      "description": "敵チャンピオンに対する攻撃およびスキルで「不退転」のスタックを獲得し、スタックごとに攻撃力が増加する。「不退転」が最大スタックになると、攻撃力が増加し、復活できるようになる。",
      "image": "ZaahenP.png"
    }
  ],
  "spells": [
    {
      "slot": "Q",
      "name": "ダーキングレイヴ",
      "description": "次の通常攻撃で2回斬りつけ、追加ダメージを与え、自身を回復する。スキルを再使用すると、次の通常攻撃で追加ダメージを与え、対象をノックアップさせる。<br>",
      "cooldown": "10/9/8/7/6",
      "cost": "25",
      "image": "ZaahenQ.png"
    },
    {
      "slot": "W",
      "name": "戦慄の再臨",
      "description": "指定方向を突き刺し、命中した敵にダメージを与えた後、自身の方向へ引き寄せる。",
      "cooldown": "14/13.5/13/12.5/12",
      "cost": "50",
      "image": "ZaahenW.png"
    },
    {
      "slot": "E",
      "name": "絢爛たる進撃",
      "description": "前方に突進し、周囲を斬りつける。",
      "cooldown": "10/9.5/9/8.5/8",
      "cost": "40",
      "image": "ZaahenE.png"
    },
    {
      "slot": "R",
      "name": "無慈悲なる裁き",
      "description": "上昇した後、下方へ突き刺し、敵にダメージを与え、与えたダメージの一定割合の体力を回復する。",
      "cooldown": "110/95/80",
      "cost": "100",
      "image": "ZaahenR.png"
    }
  ],
