  "abilities": [
    {
      "slot": "Passive",
      "name": "魂の束縛",
      "description": "近くで倒れた敵の魂を集め、物理防御と魔力を永続的に獲得する。",
      "image": "Thresh_Passive.png"
    }
  ],
  "spells": [
    {
      "slot": "Q",
      "name": "死の宣告",
      "description": "敵に鎖を投げ、命中した対象をそばに引き寄せる。もう一度発動すると、つないだ鎖をたぐって対象まで移動する。",
      "cooldown": "19/16.5/14/11.5/9",
      "cost": "70",
      "image": "ThreshQ.png"
    },
    {
      "slot": "W",
      "name": "嘆きの魂灯",
      "description": "ランタンを投げて、その周囲にいる味方チャンピオンにシールドを付与する。ランタンをクリックした味方チャンピオンは、スレッシュの元に素早く移動できる。",
      "cooldown": "21/20/19/18/17",
      "cost": "50/55/60/65/70",
      "image": "ThreshW.png"
    },
    {
      "slot": "E",
      "name": "絶望の鎖",
      "description": "前回の通常攻撃から経過した時間に応じて次の通常攻撃が強化される。発動すると鎖を投げ、範囲内の敵ユニットを鎖が投げられた方向へ弾き飛ばす。",
      "cooldown": "13/12.25/11.5/10.75/10",
      "cost": "60/65/70/75/80",
      "image": "ThreshE.png"
    },
    {
      "slot": "R",
      "name": "魂の牢獄",
      "description": "牢獄の壁を出現させる。壁を壊した者にダメージを与えスロウ効果を付与する。",
      "cooldown": "120/100/80",
      "cost": "100",
      "image": "ThreshRPenta.png"
    }
  ],
