      "cost": "65",
      "image": "FiddleSticksQ.png"
    },
    {
      "slot": "W",
      "name": "豊かな収穫",
      "description": "周囲の敵から体力を奪い、効果時間終了時に対象の減少体力に応じた追加ダメージを与える。",
      "cooldown": "10/9.5/9/8.5/8",
      "cost": "60/65/70/75/80",
      "image": "FiddleSticksW.png"
    },
    {
      "slot": "E",
      "name": "刈り取り",
      "description": "一定範囲を鎌で斬りつけて、命中したすべての敵にスロウ効果を与える。また、範囲の中心にいた敵にはサイレンス効果を与える。",
      "cooldown": "10/9/8/7/6",
      "cost": "40/45/50/55/60",
      "image": "FiddleSticksE.png"
    },
    {
      "slot": "R",
      "name": "クロウストーム",
      "description": "自身の周囲に凶暴なカラスの群れを集め、効果範囲内の敵ユニット全員に毎秒ダメージを与える。",
