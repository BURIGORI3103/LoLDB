  "abilities": [
    {
      "slot": "Passive",
      "name": "サンライト",
      "description": "攻撃スキルが命中した敵に1.5秒間「サンライト」の効果を付与する。この状態の対象に味方チャンピオンがダメージを与えると「サンライト」を消費して追加魔法ダメージを与える。",
      "image": "LeonaSunlight.png"
    }
  ],
  "spells": [
    {
      "slot": "Q",
      "name": "シールド・オブ・デイブレイク",
      "description": "次の通常攻撃時に盾を使って攻撃し、追加魔法ダメージを与えて対象にスタン効果を付与する。",
      "cooldown": "5",
      "cost": "30/35/40/45/50",
      "image": "LeonaShieldOfDaybreak.png"
    },
    {
      "slot": "W",
      "name": "エクリプス",
      "description": "自身の体を盾で保護し、ダメージ軽減率、物理防御、魔法防御を増加させる。効果時間終了時に近くに敵がいる場合は、その全員に魔法ダメージを与え、さらにシールドの効果時間が延長される。",
      "cooldown": "14/13/12/11/10",
      "cost": "60",
      "image": "LeonaSolarBarrier.png"
    },
    {
      "slot": "E",
      "name": "ゼニスブレード",
      "description": "剣から太陽のエネルギーを放ち、直線上のすべての敵に魔法ダメージを与える。最後に命中した敵チャンピオンに一時的なスネア効果を付与し、レオナが近くまで素早く移動する。",
      "cooldown": "12/10.5/9/7.5/6",
      "cost": "40/45/50/55/60",
      "image": "LeonaZenithBlade.png"
    },
    {
      "slot": "R",
      "name": "ソーラーフレア",
      "description": "指定地点に太陽の力を呼び寄せ、効果範囲内の敵ユニットにダメージを与える。範囲の中心部にいる敵にスタン効果を与え、外側にいる敵にはスロウ効果を与える。",
      "cooldown": "90/75/60",
      "cost": "100",
      "image": "LeonaSolarFlare.png"
    }
  ],
