  "abilities": [
    {
      "slot": "Passive",
      "name": "妖艶な蛇行",
      "description": "カシオペアは獲得するあらゆる移動速度ボーナスの効果が増加する。",
      "image": "Cassiopeia_Passive.png"
    }
  ],
  "spells": [
    {
      "slot": "Q",
      "name": "ノクサスブラスト",
      "description": "発動から一瞬遅れて指定地点に強力な毒を噴出させる。このスキルがチャンピオンに命中すると、自身の移動速度が増加する。",
      "cooldown": "3.5",
      "cost": "50/55/60/65/70",
      "image": "CassiopeiaQ.png"
    },
    {
      "slot": "W",
      "name": "ミアズマ",
      "description": "多数の毒霧を発生させ、その範囲に足を踏み入れた敵にスロウ効果と釘付け効果に加え、軽度のダメージを与える。釘付け効果を受けた敵は、移動スキルを使用することができない。",
      "cooldown": "24/22/20/18/16",
      "cost": "70/75/80/85/90",
      "image": "CassiopeiaW.png"
    },
    {
      "slot": "E",
      "name": "ツインファング",
      "description": "毒に侵された対象に対してダメージが増加する攻撃を繰り出す。与えたダメージの一定割合分、自身の体力を回復する。また、このスキルで対象を倒すと自身のマナを回復する。",
      "cooldown": "0.75",
      "cost": "45",
      "image": "CassiopeiaE.png"
    },
    {
      "slot": "R",
      "name": "石化の魔眼",
      "description": "石化の魔眼を開放し、扇形範囲内で自身のほうを向いている敵にスタン効果を付与する。<br>自身に背を向けている敵にはスロウ効果を付与する。",
      "cooldown": "120/100/80",
      "cost": "100",
      "image": "CassiopeiaR.png"
    }
  ],
